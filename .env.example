# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# LLM (any OpenAI-compatible endpoint, driven by the openai SDK)
# groq:   https://api.groq.com/openai/v1              e.g. llama-3.3-70b-versatile
# gemini: https://generativelanguage.googleapis.com/v1beta/openai/   e.g. gemini-2.5-flash
# ollama: http://localhost:11434/v1                   e.g. llama3.1  (no API key needed)
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# Agent loop guardrails
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_MS=60000
